{
  "astrojones-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/antigravity_pre_tool_use.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/antigravity_post_tool_use.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
